# Optional. Without these keys, PharmaSignal still runs in labelled demo mode.
GEMINI_API_KEY=
# Stable Gemini API model; you can override this if Google changes model availability.
GEMINI_MODEL=gemini-3.8-flash
TAVILY_API_KEY=
# Comma-separated list. Use * for local/student demo deployments if needed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
